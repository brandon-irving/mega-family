# Loaded by Expo in development mode only (docs.expo.dev/guides/environment-variables — Development
# mode loads .env.development.local, .env.local, .env.development, .env, in that order). Not a secret:
# only turns on the Welcome screen's "Demo: sign in as…" list (src/app/welcome.tsx), gated client-side by
# this flag and server-side by convex's DEMO_MODE (shared/config/demo.ts) on the demo deployment.
EXPO_PUBLIC_DEMO_MODE=true
